#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"

// ML Kit via mobile_scanner is not compatible with arm64 iOS simulators in this project setup.
// Force x86_64 simulator builds on Apple Silicon for supported simulator runtimes.
EXCLUDED_ARCHS[sdk=iphonesimulator*]=arm64 i386
